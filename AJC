<script>
const masks = [
 "https://i.ibb.co/3m0vK0nX/clown-mask-png.png",
 "https://i.ibb.co/another1.png", // আপনি চাইলে নিজের PNG লিংক দেবেন
 "https://i.ibb.co/another2.png",
 "https://i.ibb.co/another3.png",
 "https://i.ibb.co/another4.png",
 "https://i.ibb.co/another5.png"
];
function setMask(i){ document.getElementById('mask').src = masks[i]; }
</script>
