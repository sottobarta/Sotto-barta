<!-- Mask selector added -->
<div style="position:absolute;bottom:110px;left:0;right:0;display:flex;gap:8px;overflow-x:auto;padding:0 10px">
  <button onclick="setMask(0)">🤡</button>
  <button onclick="setMask(1)">👺</button>
  <button onclick="setMask(2)">🎭</button>
  <button onclick="setMask(3)">🤖</button>
  <button onclick="setMask(4)">👻</button>
  <button onclick="setMask(5)">😎</button>
